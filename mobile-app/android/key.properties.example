# Copy to android/key.properties (git-ignored) to sign release builds with your upload key.
# Create the keystore once (keep it and its passwords safe and backed up — losing it
# means you can never update the app on the Play Store):
#   keytool -genkey -v -keystore %USERPROFILE%\bookends-upload.jks -keyalg RSA -keysize 2048 -validity 10000 -alias upload
storePassword=<keystore password>
keyPassword=<key password>
keyAlias=upload
storeFile=C:/Users/<you>/bookends-upload.jks
