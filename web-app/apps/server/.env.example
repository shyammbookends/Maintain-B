# ---- Runtime ----
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info
# Set to 1 when behind a reverse proxy (nginx, load balancer) so rate limits see the real IP.
TRUST_PROXY=0

# ---- Database ----
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/maintainx?schema=public
# Integration tests. Database name MUST end in _test (tests refuse anything else).
# Create once: createdb maintainx_test, then: DATABASE_URL=<this> npx prisma migrate deploy
TEST_DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/maintainx_test?schema=public

# ---- URLs ----
# Public URL of the web app. Used for QR code links and CORS.
APP_URL=http://localhost:5173
# Comma-separated list of allowed browser origins.
CORS_ORIGIN=http://localhost:5173

# ---- Auth ----
# Generate each with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-64-plus-random-characters-replace-with-64-plus-random-characters
JWT_REFRESH_SECRET=replace-with-64-plus-random-characters-replace-with-64-plus-random-characters
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Send auth cookies only over HTTPS. Must be true in production.
COOKIE_SECURE=false

# ---- File storage ----
# local = files on this server's disk (dev).
# supabase = a private Supabase Storage bucket (recommended for production; free plan 1 GB).
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
# STORAGE_DRIVER=supabase:
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=        # server only — never put it in the web app
# SUPABASE_BUCKET=maintenance-files
# STORAGE_QUOTA_MB=1024             # storage alerts at 80% / 95%
# DATABASE_QUOTA_MB=500
# STORAGE_DRIVER=s3 (AWS S3 or Cloudflare R2):
# S3_BUCKET=
# S3_REGION=ap-south-1
# S3_ENDPOINT=            # only for Cloudflare R2 / other S3-compatible services
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=false
# S3_PREFIX=prod
# Secret used to sign temporary file download links.
FILE_SIGNING_SECRET=replace-with-64-plus-random-characters-replace-with-64-plus-random-characters
MAX_UPLOAD_MB=25

# ---- Rate limiting ----
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=1500

# ---- Seed (first Super Admin) ----
SEED_ORG_NAME=Bookends Hospitality
SEED_ADMIN_EMAIL=admin@bookends.local
SEED_ADMIN_PASSWORD=ChangeMe123

# End-to-end tests (Playwright) reset and seed this database. Name must end in _test.
E2E_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/maintainx_e2e_test?schema=public

# --- Notification delivery (optional) -------------------------------------
# Email: users choose per type in Notification settings.
# SMTP_URL=smtps://user:password@smtp.example.com:465
# MAIL_FROM="Bookends Maintenance <maintenance@example.com>"
# Web Push (free): run `npm run push:keys` and paste the three lines (set both keys or neither).
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:maintenance@example.com
# Gmail works for email: smtps://you%40gmail.com:<16-letter app password>@smtp.gmail.com:465
# Scheduled email reports use the same SMTP settings. See docs/DEPLOYMENT.md.

# --- Background jobs on serverless hosting (optional) ---------------------
# Enables GET /api/v1/jobs/run (Authorization: Bearer <CRON_SECRET>), called by
# Vercel Cron and the GitHub Actions workflow every 15 minutes.
# CRON_SECRET=

# --- Single sign-on (optional, free) -------------------------------------
# Only people who already have an account (same email) can sign in this way.
# Redirect URI to register: <APP_URL>/api/v1/auth/sso/google/callback (or /microsoft/callback)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_TENANT_ID=        # your directory (tenant) id
