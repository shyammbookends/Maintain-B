{
  "name": "@maintainx/server",
  "version": "0.1.0",
  "private": true,
  "description": "REST API for the restaurant maintenance platform",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset --force",
    "db:seed": "prisma db seed",
    "db:seed:demo": "tsx prisma/demo-data.ts",
    "db:studio": "prisma studio",
    "push:keys": "node scripts/generate-vapid-keys.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1145.0",
    "@aws-sdk/s3-request-presigner": "^3.1145.0",
    "@maintainx/shared": "*",
    "@node-rs/argon2": "^2.0.2",
    "@prisma/client": "^6.11.1",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.1",
    "file-type": "^21.3.4",
    "helmet": "^8.1.0",
    "jose": "^6.2.12",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.14",
    "pdfkit": "^0.20.2",
    "pino": "^9.7.0",
    "pino-http": "^10.5.0",
    "sharp": "^0.35.5",
    "web-push": "^3.6.7",
    "zod": "^4.0.5"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.0.10",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.6",
    "@types/supertest": "^6.0.3",
    "@types/web-push": "^3.6.4",
    "autocannon": "^8.0.0",
    "pino-pretty": "^13.0.0",
    "prisma": "^6.11.1",
    "supertest": "^7.1.3",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
