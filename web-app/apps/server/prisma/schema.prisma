// =============================================================================
// Organization, identity & access
// =============================================================================

model Organization {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  slug      String   @unique
  timezone  String   @default("Asia/Kolkata")
  currency  String   @default("INR")
  locale    String   @default("en")
  logoKey   String?  @map("logo_key")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  users                 User[]
  roles                 Role[]
  teams                 Team[]
  restaurants           Restaurant[]
  locations             Location[]
  assetCategories       AssetCategory[]
  assets                Asset[]
  requests              Request[]
  workOrders            WorkOrder[]
  procedures            Procedure[]
  pmSchedules           PmSchedule[]
  inspectionTemplates   InspectionTemplate[]
  inspections           Inspection[]
  parts                 Part[]
  inventory             Inventory[]
  inventoryTransactions InventoryTransaction[]
  partReservations      PartReservation[]
  stockCounts           StockCount[]
  vendorContracts       VendorContract[]
  vendors               Vendor[]
  vendorInvoices        VendorInvoice[]
  purchaseOrders        PurchaseOrder[]
  documents             Document[]
  notifications         Notification[]
  auditLogs             AuditLog[]
  settings              Setting[]
  counters              Counter[]

  assetMeters       AssetMeter[]
  automations       Automation[]
  rootCauseAnalyses RootCauseAnalysis[]
  savedViews        SavedView[]
  customFieldDefs   CustomField[]
  labels            Label[]
  conversations     Conversation[]
  apiKeys           ApiKey[]
  webhooks          Webhook[]
  reportSchedules   ReportSchedule[]

  @@map("organizations")
}

model User {
  id                 String     @id @default(uuid()) @db.Uuid
  organizationId     String     @map("organization_id") @db.Uuid
  email              String?
  username           String?
  phone              String?
  passwordHash       String     @map("password_hash")
  firstName          String     @map("first_name")
  lastName           String     @map("last_name")
  preferredLocale    String     @default("en") @map("preferred_locale")
  status             UserStatus @default(ACTIVE)
  avatarKey          String?    @map("avatar_key")
  mustChangePassword Boolean    @default(false) @map("must_change_password")
  failedLoginCount   Int        @default(0) @map("failed_login_count")
  lockedUntil        DateTime?  @map("locked_until") @db.Timestamptz
  lastLoginAt        DateTime?  @map("last_login_at") @db.Timestamptz
  jobTitle           String?    @map("job_title")
  /// Labour cost per hour, used for work-order and asset cost.
  hourlyRate         Decimal?   @map("hourly_rate") @db.Decimal(10, 2)
  /// Bumped to invalidate every session (password change, role/restaurant change, admin revoke).
  tokenVersion       Int        @default(1) @map("token_version")
  /// The admin dashboard this person arranged: widget keys in order (null = default).
  dashboardLayout    Json?      @map("dashboard_layout")
  archivedAt         DateTime?  @map("archived_at") @db.Timestamptz
  createdAt          DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime   @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id])

  userRoles                UserRole[]
  userRestaurants          UserRestaurant[]
  refreshTokens            RefreshToken[]
  teamMemberships          TeamMember[]
  ledTeams                 Team[]                   @relation("TeamLead")
  requestsMade             Request[]                @relation("RequestRequester")
  requestsReviewed         Request[]                @relation("RequestReviewer")
  assignedWorkOrders       WorkOrder[]              @relation("WorkOrderAssignee")
  createdWorkOrders        WorkOrder[]              @relation("WorkOrderCreator")
  closedWorkOrders         WorkOrder[]              @relation("WorkOrderCloser")
  supervisedWorkOrders     WorkOrder[]              @relation("WorkOrderSupervisor")
  verifiedWorkOrders       WorkOrder[]              @relation("WorkOrderVerifier")
  workOrderAssignments     WorkOrderAssignment[]    @relation("WorkOrderHelper")
  workOrderAssignmentsMade WorkOrderAssignment[]    @relation("WorkOrderHelperAddedBy")
  workOrderCosts           WorkOrderCost[]
  managedRestaurants       Restaurant[]             @relation("RestaurantManager")
  workOrderStatusChanges   WorkOrderStatusHistory[]
  checklistCompletions     WorkOrderChecklistItem[]
  timeEntries              WorkOrderTimeEntry[]
  timeEntriesCreated       WorkOrderTimeEntry[]     @relation("TimeEntryCreator")
  completionReports        WorkOrderCompletion[]
  messages                 Message[]
  attachments              Attachment[]
  assetHistoryEvents       AssetHistory[]
  pmSchedulesAsAssignee    PmSchedule[]             @relation("PmDefaultAssignee")
  inspectionsPerformed     Inspection[]
  inventoryTransactions    InventoryTransaction[]
  stockIssued              InventoryTransaction[]   @relation("StockIssuedTo")
  partReservations         PartReservation[]        @relation("ReservationCreator")
  stockCountsCreated       StockCount[]             @relation("StockCountCreator")
  stockCountsCompleted     StockCount[]             @relation("StockCountCompleter")
  stockCountLines          StockCountLine[]         @relation("StockCountLineCounter")
  purchaseOrdersRequested  PurchaseOrder[]          @relation("PoRequester")
  purchaseOrdersApproved   PurchaseOrder[]          @relation("PoApprover")
  poReceipts               PoReceipt[]
  documentsUploaded        Document[]
  notifications            Notification[]
  notificationPreferences  NotificationPreference[]
  auditLogs                AuditLog[]

  meterReadings      MeterReading[]      @relation("MeterReader")
  automationsCreated Automation[]        @relation("AutomationCreator")
  rcasCreated        RootCauseAnalysis[] @relation("RcaCreator")
  rcasUpdated        RootCauseAnalysis[] @relation("RcaUpdater")

  pushSubscriptions PushSubscription[]
  savedViews        SavedView[]
  chatMemberships   ConversationMember[]
  chatMessages      ChatMessage[]
  conversationsMade Conversation[]
  apiKeysCreated    ApiKey[]
  reportSchedules   ReportSchedule[]

  @@unique([organizationId, email])
  @@unique([organizationId, username])
  @@unique([organizationId, phone])
  @@index([organizationId, status])
  @@map("users")
}

model Role {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  description    String?
  /// Which shell the role lands in: ADMIN (desktop) or WORKER (mobile-first).
  kind           RoleKind @default(ADMIN)
  isSystem       Boolean  @default(false) @map("is_system")
  /// SUPER_ADMIN | ADMIN | WORKER (shown as "User"). The only roles; null only on legacy rows.
  systemKey      String?  @map("system_key")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  organization    Organization     @relation(fields: [organizationId], references: [id])
  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@unique([organizationId, name])
  @@unique([organizationId, systemKey])
  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  /// e.g. "work_orders:assign"
  key         String           @unique
  resource    String
  action      PermissionAction
  description String?

  rolePermissions RolePermission[]

  @@unique([resource, action])
  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId     String   @map("user_id") @db.Uuid
  roleId     String   @map("role_id") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

/// Restaurant scope: which restaurants a user may see/act on. Super Admin bypasses this.
model UserRestaurant {
  userId       String   @map("user_id") @db.Uuid
  restaurantId String   @map("restaurant_id") @db.Uuid
  assignedAt   DateTime @default(now()) @map("assigned_at") @db.Timestamptz

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@id([userId, restaurantId])
  @@index([restaurantId])
  @@map("user_restaurants")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  /// All rotations of one login share a family; reuse of a revoked token revokes the family.
  familyId  String    @map("family_id") @db.Uuid
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz
  userAgent String?   @map("user_agent")
  ip        String?
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model Team {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  /// Null = organization-wide team.
  restaurantId   String?   @map("restaurant_id") @db.Uuid
  name           String
  description    String?
  leadUserId     String?   @map("lead_user_id") @db.Uuid
  archivedAt     DateTime? @map("archived_at") @db.Timestamptz
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id])
  restaurant   Restaurant?  @relation(fields: [restaurantId], references: [id])
  lead         User?        @relation("TeamLead", fields: [leadUserId], references: [id])
  members      TeamMember[]
  workOrders   WorkOrder[]
  pmSchedules  PmSchedule[]

  @@unique([organizationId, name])
  @@index([restaurantId])
  @@map("teams")
}

model TeamMember {
  teamId   String   @map("team_id") @db.Uuid
  userId   String   @map("user_id") @db.Uuid
  joinedAt DateTime @default(now()) @map("joined_at") @db.Timestamptz

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([teamId, userId])
  @@index([userId])
  @@map("team_members")
}

// =============================================================================
// Restaurants & locations
// =============================================================================

model Restaurant {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  /// Short human code, e.g. "R1", "BKD-SG".
  code           String
  name           String
  addressLine1   String?          @map("address_line1")
  addressLine2   String?          @map("address_line2")
  city           String?
  state          String?
  postalCode     String?          @map("postal_code")
  phone          String?
  email          String?
  timezone       String           @default("Asia/Kolkata")
  /// "HH:mm" local time; used by opening/closing inspection reminders.
  opensAt        String?          @map("opens_at")
  closesAt       String?          @map("closes_at")
  /// The person in charge on site (shown on the restaurant and used for escalations).
  managerId      String?          @map("manager_id") @db.Uuid
  contactName    String?          @map("contact_name")
  /// Random id in the public request portal link (/p/<portalId>); no login needed.
  portalId       String           @unique @default(dbgenerated("replace((gen_random_uuid())::text, '-'::text, ''::text)")) @map("portal_id")
  status         RestaurantStatus @default(ACTIVE)
  archivedAt     DateTime?        @map("archived_at") @db.Timestamptz
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id])
  manager      User?        @relation("RestaurantManager", fields: [managerId], references: [id])

  locations             Location[]
  userRestaurants       UserRestaurant[]
  teams                 Team[]
  assets                Asset[]
  requests              Request[]
  workOrders            WorkOrder[]
  procedures            Procedure[]
  pmSchedules           PmSchedule[]
  inspectionTemplates   InspectionTemplate[]
  inspections           Inspection[]
  inventory             Inventory[]
  inventoryTransactions InventoryTransaction[]
  partReservations      PartReservation[]
  stockCounts           StockCount[]
  vendorContracts       VendorContract[]
  vendorRestaurants     VendorRestaurant[]
  vendorInvoices        VendorInvoice[]
  purchaseOrders        PurchaseOrder[]
  documents             Document[]
  auditLogs             AuditLog[]
  settings              Setting[]

  automations     Automation[]
  reportSchedules ReportSchedule[]

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@map("restaurants")
}

model Location {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  restaurantId   String       @map("restaurant_id") @db.Uuid
  parentId       String?      @map("parent_id") @db.Uuid
  /// Random id embedded in the location QR code (/l/<publicId>).
  publicId       String       @unique @default(dbgenerated("replace((gen_random_uuid())::text, '-'::text, ''::text)")) @map("public_id")
  name           String
  type           LocationType @default(OTHER)
  description    String?
  archivedAt     DateTime?    @map("archived_at") @db.Timestamptz
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id])
  restaurant   Restaurant   @relation(fields: [restaurantId], references: [id])
  parent       Location?    @relation("LocationTree", fields: [parentId], references: [id])
  children     Location[]   @relation("LocationTree")
  assets       Asset[]
  requests     Request[]
  workOrders   WorkOrder[]

  @@unique([restaurantId, name])
  @@index([restaurantId, type])
  @@map("locations")
}

// =============================================================================
// Assets
// =============================================================================

model AssetCategory {
  id                 String    @id @default(uuid()) @db.Uuid
  organizationId     String    @map("organization_id") @db.Uuid
  name               String
  iconKey            String?   @map("icon_key")
  /// Procedure offered by default when creating work orders for this category.
  defaultProcedureId String?   @map("default_procedure_id") @db.Uuid
  archivedAt         DateTime? @map("archived_at") @db.Timestamptz
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  organization     Organization @relation(fields: [organizationId], references: [id])
  defaultProcedure Procedure?   @relation(fields: [defaultProcedureId], references: [id])
  assets           Asset[]

  @@unique([organizationId, name])
  @@map("asset_categories")
}

model Asset {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  /// Random, unguessable id embedded in the QR code URL (/a/<publicId>).
  publicId       String           @unique @map("public_id")
  /// Human code, e.g. AST-0042.
  assetCode      String           @map("asset_code")
  name           String
  categoryId     String           @map("category_id") @db.Uuid
  restaurantId   String           @map("restaurant_id") @db.Uuid
  locationId     String?          @map("location_id") @db.Uuid
  /// Component of a bigger asset (e.g. compressor inside a cold room).
  parentId       String?          @map("parent_id") @db.Uuid
  criticality    AssetCriticality @default(MEDIUM)
  installDate    DateTime?        @map("install_date") @db.Date
  manufacturer   String?
  model          String?
  serialNumber   String?          @map("serial_number")
  purchaseDate   DateTime?        @map("purchase_date") @db.Date
  purchaseCost   Decimal?         @map("purchase_cost") @db.Decimal(12, 2)
  warrantyStart  DateTime?        @map("warranty_start") @db.Date
  warrantyEnd    DateTime?        @map("warranty_end") @db.Date
  vendorId       String?          @map("vendor_id") @db.Uuid
  status         AssetStatus      @default(OPERATIONAL)
  imageKey       String?          @map("image_key")
  notes          String?
  /// Values of the organisation's custom fields, keyed by CustomField id.
  customFields   Json             @default("{}") @map("custom_fields")
  archivedAt     DateTime?        @map("archived_at") @db.Timestamptz
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization  @relation(fields: [organizationId], references: [id])
  category     AssetCategory @relation(fields: [categoryId], references: [id])
  restaurant   Restaurant    @relation(fields: [restaurantId], references: [id])
  location     Location?     @relation(fields: [locationId], references: [id])
  vendor       Vendor?       @relation(fields: [vendorId], references: [id])
  parent       Asset?        @relation("AssetTree", fields: [parentId], references: [id])
  children     Asset[]       @relation("AssetTree")

  history     AssetHistory[]
  downtimes   AssetDowntime[]
  requests    Request[]
  workOrders  WorkOrder[]
  pmSchedules PmSchedule[]
  inspections Inspection[]

  meters            AssetMeter[]
  rootCauseAnalyses RootCauseAnalysis[]

  @@unique([organizationId, assetCode])
  @@index([restaurantId, status])
  @@index([categoryId])
  @@index([warrantyEnd])
  @@index([serialNumber])
  @@index([parentId])
  @@map("assets")
}

/// Append-only timeline shown as "Maintenance History" on the asset page.
model AssetHistory {
  id          String         @id @default(uuid()) @db.Uuid
  assetId     String         @map("asset_id") @db.Uuid
  eventType   AssetEventType @map("event_type")
  workOrderId String?        @map("work_order_id") @db.Uuid
  actorId     String?        @map("actor_id") @db.Uuid
  oldValue    Json?          @map("old_value")
  newValue    Json?          @map("new_value")
  note        String?
  occurredAt  DateTime       @default(now()) @map("occurred_at") @db.Timestamptz

  asset     Asset      @relation(fields: [assetId], references: [id])
  workOrder WorkOrder? @relation(fields: [workOrderId], references: [id])
  actor     User?      @relation(fields: [actorId], references: [id])

  @@index([assetId, occurredAt])
  @@map("asset_history")
}

/// Opened when an asset becomes BROKEN, closed when it is OPERATIONAL again.
model AssetDowntime {
  id          String    @id @default(uuid()) @db.Uuid
  assetId     String    @map("asset_id") @db.Uuid
  workOrderId String?   @map("work_order_id") @db.Uuid
  startedAt   DateTime  @map("started_at") @db.Timestamptz
  endedAt     DateTime? @map("ended_at") @db.Timestamptz
  reason      String?

  asset     Asset      @relation(fields: [assetId], references: [id])
  workOrder WorkOrder? @relation(fields: [workOrderId], references: [id])

  @@index([assetId, startedAt])
  @@map("asset_downtime")
}

// =============================================================================
// Requests (problem reports) & work orders
// =============================================================================

model Request {
  id                   String            @id @default(uuid()) @db.Uuid
  organizationId       String            @map("organization_id") @db.Uuid
  /// REQ-000123
  code                 String
  restaurantId         String            @map("restaurant_id") @db.Uuid
  locationId           String?           @map("location_id") @db.Uuid
  assetId              String?           @map("asset_id") @db.Uuid
  category             WorkOrderCategory @default(OTHER)
  title                String
  description          String
  priority             Priority          @default(MEDIUM)
  status               RequestStatus     @default(NEW)
  /// Null for guests who reported through the public portal.
  requestedById        String?           @map("requested_by_id") @db.Uuid
  /// Portal guests: their name and phone (digits only) to follow up and look up status.
  guestName            String?           @map("guest_name")
  guestPhone           String?           @map("guest_phone")
  reviewedById         String?           @map("reviewed_by_id") @db.Uuid
  reviewedAt           DateTime?         @map("reviewed_at") @db.Timestamptz
  rejectionReason      String?           @map("rejection_reason")
  /// Reviewer's note when approving (what happens next, when).
  reviewNote           String?           @map("review_note")
  convertedWorkOrderId String?           @unique @map("converted_work_order_id") @db.Uuid
  createdAt            DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime          @updatedAt @map("updated_at") @db.Timestamptz

  organization       Organization @relation(fields: [organizationId], references: [id])
  restaurant         Restaurant   @relation(fields: [restaurantId], references: [id])
  location           Location?    @relation(fields: [locationId], references: [id])
  asset              Asset?       @relation(fields: [assetId], references: [id])
  requestedBy        User?        @relation("RequestRequester", fields: [requestedById], references: [id])
  reviewedBy         User?        @relation("RequestReviewer", fields: [reviewedById], references: [id])
  convertedWorkOrder WorkOrder?   @relation("RequestConversion", fields: [convertedWorkOrderId], references: [id])

  @@unique([organizationId, code])
  @@index([restaurantId, status, createdAt])
  @@index([requestedById])
  @@index([restaurantId, guestPhone])
  @@map("requests")
}

model WorkOrder {
  id               String            @id @default(uuid()) @db.Uuid
  organizationId   String            @map("organization_id") @db.Uuid
  /// WO-000123
  code             String
  title            String
  description      String?
  type             WorkOrderType     @default(REACTIVE)
  category         WorkOrderCategory @default(OTHER)
  restaurantId     String            @map("restaurant_id") @db.Uuid
  locationId       String?           @map("location_id") @db.Uuid
  assetId          String?           @map("asset_id") @db.Uuid
  priority         Priority          @default(MEDIUM)
  status           WorkOrderStatus   @default(OPEN)
  assignedUserId   String?           @map("assigned_user_id") @db.Uuid
  assignedTeamId   String?           @map("assigned_team_id") @db.Uuid
  /// Planned start; set together with an assignee it puts the job in SCHEDULED.
  scheduledStart   DateTime?         @map("scheduled_start") @db.Timestamptz
  dueDate          DateTime?         @map("due_date") @db.Timestamptz
  estimatedMinutes Int?              @map("estimated_minutes")
  /// Outside contractor doing (part of) the job.
  vendorId         String?           @map("vendor_id") @db.Uuid
  /// Checks the finished work (falls back to anyone with work_orders:approve).
  supervisorId     String?           @map("supervisor_id") @db.Uuid
  /// Parent job for large work split into sub work orders.
  parentId         String?           @map("parent_id") @db.Uuid
  actualMinutes    Int?              @map("actual_minutes")
  procedureId      String?           @map("procedure_id") @db.Uuid
  pmScheduleId     String?           @map("pm_schedule_id") @db.Uuid
  /// The occurrence this PM work order represents; unique per schedule to prevent duplicates.
  pmDueDate        DateTime?         @map("pm_due_date") @db.Date
  createdById      String            @map("created_by_id") @db.Uuid
  startedAt        DateTime?         @map("started_at") @db.Timestamptz
  completedAt      DateTime?         @map("completed_at") @db.Timestamptz
  closedAt         DateTime?         @map("closed_at") @db.Timestamptz
  closedById       String?           @map("closed_by_id") @db.Uuid
  verifiedAt       DateTime?         @map("verified_at") @db.Timestamptz
  verifiedById     String?           @map("verified_by_id") @db.Uuid
  cancelledAt      DateTime?         @map("cancelled_at") @db.Timestamptz
  cancelReason     String?           @map("cancel_reason")
  /// Last reason a supervisor sent the work back.
  rejectionReason  String?           @map("rejection_reason")
  reopenCount      Int               @default(0) @map("reopen_count")
  holdReason       String?           @map("hold_reason")
  completionNotes  String?           @map("completion_notes")
  /// Values of the organisation's custom fields, keyed by CustomField id.
  customFields     Json              @default("{}") @map("custom_fields")
  /// Repeat: every N units, counted from the due date (SCHEDULE) or from completion.
  repeatEvery      Int?              @map("repeat_every")
  repeatUnit       RepeatUnit?       @map("repeat_unit")
  repeatBasis      RepeatBasis?      @map("repeat_basis")
  /// The earlier job this one repeats (one follow-up per job).
  repeatedFromId   String?           @unique @map("repeated_from_id") @db.Uuid
  archivedAt       DateTime?         @map("archived_at") @db.Timestamptz
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz

  organization  Organization     @relation(fields: [organizationId], references: [id])
  restaurant    Restaurant       @relation(fields: [restaurantId], references: [id])
  location      Location?        @relation(fields: [locationId], references: [id])
  asset         Asset?           @relation(fields: [assetId], references: [id])
  assignedUser  User?            @relation("WorkOrderAssignee", fields: [assignedUserId], references: [id])
  assignedTeam  Team?            @relation(fields: [assignedTeamId], references: [id])
  procedure     Procedure?       @relation(fields: [procedureId], references: [id])
  pmSchedule    PmSchedule?      @relation(fields: [pmScheduleId], references: [id])
  createdBy     User             @relation("WorkOrderCreator", fields: [createdById], references: [id])
  closedBy      User?            @relation("WorkOrderCloser", fields: [closedById], references: [id])
  verifiedBy    User?            @relation("WorkOrderVerifier", fields: [verifiedById], references: [id])
  supervisor    User?            @relation("WorkOrderSupervisor", fields: [supervisorId], references: [id])
  vendor        Vendor?          @relation(fields: [vendorId], references: [id])
  parent        WorkOrder?       @relation("WorkOrderTree", fields: [parentId], references: [id])
  children      WorkOrder[]      @relation("WorkOrderTree")
  sourceRequest Request?         @relation("RequestConversion")
  repeatedFrom  WorkOrder?       @relation("WorkOrderRepeat", fields: [repeatedFromId], references: [id])
  labels        WorkOrderLabel[]
  repeatedBy    WorkOrder?       @relation("WorkOrderRepeat")

  helpers    WorkOrderAssignment[]
  costs      WorkOrderCost[]
  completion WorkOrderCompletion?

  statusHistory           WorkOrderStatusHistory[]
  checklistItems          WorkOrderChecklistItem[]
  parts                   WorkOrderPart[]
  timeEntries             WorkOrderTimeEntry[]
  partReservations        PartReservation[]
  messages                Message[]
  assetHistory            AssetHistory[]
  downtimes               AssetDowntime[]
  correctiveForChecklist  WorkOrderChecklistItem[] @relation("ChecklistCorrectiveWorkOrder")
  correctiveForInspection InspectionItem[]         @relation("InspectionCorrectiveWorkOrder")
  vendorInvoices          VendorInvoice[]

  meterReadings MeterReading[]
  rootCause     RootCauseAnalysis?

  @@unique([organizationId, code])
  @@unique([pmScheduleId, pmDueDate])
  @@index([restaurantId, status])
  @@index([assignedUserId, status])
  @@index([assignedTeamId, status])
  @@index([dueDate])
  /// Overdue scans: active statuses with a due date in the past.
  @@index([status, dueDate])
  @@index([assetId])
  @@index([createdAt])
  @@index([parentId])
  @@index([vendorId])
  @@index([scheduledStart])
  @@map("work_orders")
}

/**
 * The technician's structured hand-in: what was found, why, what was done,
 * what was fitted or taken out, and the state it was left in. Rewritten each
 * time the job is completed again after a rework.
 */
model WorkOrderCompletion {
  id                  String         @id @default(uuid()) @db.Uuid
  workOrderId         String         @unique @map("work_order_id") @db.Uuid
  problemFound        String         @map("problem_found")
  rootCause           String?        @map("root_cause")
  workPerformed       String         @map("work_performed")
  newPartsInstalled   String?        @map("new_parts_installed")
  oldPartsRemoved     String?        @map("old_parts_removed")
  quantityRepaired    Int?           @map("quantity_repaired")
  quantityReplaced    Int?           @map("quantity_replaced")
  additionalMaterials String?        @map("additional_materials")
  additionalIssue     String?        @map("additional_issue")
  recommendation      String?
  notes               String?
  finalCondition      FinalCondition @map("final_condition")
  /// No spare parts were needed (stated explicitly by the technician).
  noPartsUsed         Boolean        @default(false) @map("no_parts_used")
  labourMinutes       Int            @default(0) @map("labour_minutes")
  confirmedById       String         @map("confirmed_by_id") @db.Uuid
  confirmedAt         DateTime       @map("confirmed_at") @db.Timestamptz
  createdAt           DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime       @updatedAt @map("updated_at") @db.Timestamptz

  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  confirmedBy User      @relation(fields: [confirmedById], references: [id])

  @@map("work_order_completion_reports")
}

/// Extra technicians working a job alongside the primary assignee.
model WorkOrderAssignment {
  workOrderId String   @map("work_order_id") @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  addedById   String   @map("added_by_id") @db.Uuid
  addedAt     DateTime @default(now()) @map("added_at") @db.Timestamptz

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  user      User      @relation("WorkOrderHelper", fields: [userId], references: [id])
  addedBy   User      @relation("WorkOrderHelperAddedBy", fields: [addedById], references: [id])

  @@id([workOrderId, userId])
  @@index([userId])
  @@map("work_order_assignments")
}

/// Costs other than parts and logged labour (vendor charges, materials bought, travel…).
model WorkOrderCost {
  id          String            @id @default(uuid()) @db.Uuid
  workOrderId String            @map("work_order_id") @db.Uuid
  type        WorkOrderCostType
  description String
  amount      Decimal           @db.Decimal(12, 2)
  vendorId    String?           @map("vendor_id") @db.Uuid
  createdById String            @map("created_by_id") @db.Uuid
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  vendor    Vendor?   @relation(fields: [vendorId], references: [id])
  createdBy User      @relation(fields: [createdById], references: [id])

  @@index([workOrderId])
  @@index([vendorId])
  @@map("work_order_costs")
}

model WorkOrderStatusHistory {
  id          String           @id @default(uuid()) @db.Uuid
  workOrderId String           @map("work_order_id") @db.Uuid
  fromStatus  WorkOrderStatus? @map("from_status")
  toStatus    WorkOrderStatus  @map("to_status")
  actorId     String?          @map("actor_id") @db.Uuid
  note        String?
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  actor     User?     @relation(fields: [actorId], references: [id])

  @@index([workOrderId, createdAt])
  @@map("work_order_status_history")
}

/// Snapshot of procedure steps at the time the work order was created,
/// so editing a procedure later never rewrites history.
model WorkOrderChecklistItem {
  id                    String        @id @default(uuid()) @db.Uuid
  workOrderId           String        @map("work_order_id") @db.Uuid
  position              Int
  title                 String
  instruction           String?
  inputType             StepInputType @default(PASS_FAIL_NA) @map("input_type")
  unit                  String?
  minValue              Decimal?      @map("min_value") @db.Decimal(12, 3)
  maxValue              Decimal?      @map("max_value") @db.Decimal(12, 3)
  required              Boolean       @default(true)
  options               String[]      @default([])
  requirePhoto          Boolean       @default(false) @map("require_photo")
  /// Shown only when step #showIfPosition was answered showIfAnswer (PASS / FAIL / NA or a choice).
  showIfPosition        Int?          @map("show_if_position")
  showIfAnswer          String?       @map("show_if_answer")
  result                StepResult?
  numericValue          Decimal?      @map("numeric_value") @db.Decimal(12, 3)
  textValue             String?       @map("text_value")
  note                  String?
  completedById         String?       @map("completed_by_id") @db.Uuid
  completedAt           DateTime?     @map("completed_at") @db.Timestamptz
  correctiveWorkOrderId String?       @map("corrective_work_order_id") @db.Uuid
  createdAt             DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  workOrder           WorkOrder  @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  completedBy         User?      @relation(fields: [completedById], references: [id])
  correctiveWorkOrder WorkOrder? @relation("ChecklistCorrectiveWorkOrder", fields: [correctiveWorkOrderId], references: [id])

  @@unique([workOrderId, position])
  @@map("work_order_checklist_items")
}

model WorkOrderPart {
  id               String        @id @default(uuid()) @db.Uuid
  workOrderId      String        @map("work_order_id") @db.Uuid
  partId           String        @map("part_id") @db.Uuid
  qtyRequired      Decimal       @default(0) @map("qty_required") @db.Decimal(12, 3)
  qtyUsed          Decimal       @default(0) @map("qty_used") @db.Decimal(12, 3)
  /// Unit cost at the time of use, for cost reports.
  unitCostSnapshot Decimal?      @map("unit_cost_snapshot") @db.Decimal(12, 2)
  condition        PartCondition @default(NEW)
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  part      Part      @relation(fields: [partId], references: [id])

  @@unique([workOrderId, partId])
  @@index([partId])
  @@map("work_order_parts")
}

model WorkOrderTimeEntry {
  id          String    @id @default(uuid()) @db.Uuid
  workOrderId String    @map("work_order_id") @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  startedAt   DateTime  @map("started_at") @db.Timestamptz
  endedAt     DateTime? @map("ended_at") @db.Timestamptz
  minutes     Int?
  note        String?
  /// Added or corrected by a manager rather than recorded by the timer.
  manual      Boolean   @default(false)
  createdById String?   @map("created_by_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id])
  createdBy User?     @relation("TimeEntryCreator", fields: [createdById], references: [id])

  @@index([workOrderId])
  @@index([userId, startedAt])
  @@map("work_order_time_entries")
}

/// Admin ↔ Worker conversation on a work order. Part of the work order's history.
model Message {
  id          String    @id @default(uuid()) @db.Uuid
  workOrderId String    @map("work_order_id") @db.Uuid
  authorId    String    @map("author_id") @db.Uuid
  /// Reply to another message on the same work order.
  parentId    String?   @map("parent_id") @db.Uuid
  /// Internal note: hidden from technicians and requesters.
  internal    Boolean   @default(false)
  /// Users @mentioned in the body.
  mentionIds  String[]  @default([]) @map("mention_ids") @db.Uuid
  body        String
  editedAt    DateTime? @map("edited_at") @db.Timestamptz
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  author    User      @relation(fields: [authorId], references: [id])
  parent    Message?  @relation("MessageReplies", fields: [parentId], references: [id], onDelete: SetNull)
  replies   Message[] @relation("MessageReplies")

  @@index([workOrderId, createdAt])
  @@map("messages")
}

/// Photos, videos and files attached to work orders, requests, checklist items and messages.
model Attachment {
  id            String              @id @default(uuid()) @db.Uuid
  ownerType     AttachmentOwnerType @map("owner_type")
  ownerId       String              @map("owner_id") @db.Uuid
  kind          AttachmentKind
  storageKey    String              @unique @map("storage_key")
  thumbKey      String?             @map("thumb_key")
  fileName      String              @map("file_name")
  mimeType      String              @map("mime_type")
  sizeBytes     Int                 @map("size_bytes")
  width         Int?
  height        Int?
  durationSec   Int?                @map("duration_sec")
  /// Work-order evidence: before / during / after the repair (null = general).
  stage         EvidenceStage?
  caption       String?
  /// Re-saved smaller once the photo is older than the compaction age.
  compactedAt   DateTime?           @map("compacted_at") @db.Timestamptz
  /// The file was removed by the retention policy (old videos, > retention years); the record stays.
  fileRemovedAt DateTime?           @map("file_removed_at") @db.Timestamptz
  /// Null for photos a guest sent through the public request portal.
  uploadedById  String?             @map("uploaded_by_id") @db.Uuid
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz

  uploadedBy User? @relation(fields: [uploadedById], references: [id])

  @@index([ownerType, ownerId])
  @@index([kind, createdAt])
  @@map("attachments")
}

// =============================================================================
// Procedures, preventive maintenance, inspections
// =============================================================================

model Procedure {
  id             String             @id @default(uuid()) @db.Uuid
  organizationId String             @map("organization_id") @db.Uuid
  /// Null = available to every restaurant.
  restaurantId   String?            @map("restaurant_id") @db.Uuid
  name           String
  category       WorkOrderCategory?
  description    String?
  version        Int                @default(1)
  archivedAt     DateTime?          @map("archived_at") @db.Timestamptz
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime           @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id])
  restaurant   Restaurant?  @relation(fields: [restaurantId], references: [id])

  steps               ProcedureStep[]
  workOrders          WorkOrder[]
  pmSchedules         PmSchedule[]
  inspectionTemplates InspectionTemplate[]
  assetCategories     AssetCategory[]

  @@unique([organizationId, name])
  @@index([restaurantId])
  @@map("procedures")
}

model ProcedureStep {
  id             String        @id @default(uuid()) @db.Uuid
  procedureId    String        @map("procedure_id") @db.Uuid
  position       Int
  title          String
  instruction    String?
  inputType      StepInputType @default(PASS_FAIL_NA) @map("input_type")
  unit           String?
  /// For NUMBER steps: a reading outside [min, max] auto-fails.
  minValue       Decimal?      @map("min_value") @db.Decimal(12, 3)
  maxValue       Decimal?      @map("max_value") @db.Decimal(12, 3)
  required       Boolean       @default(true)
  /// MULTIPLE_CHOICE: the allowed answers.
  options        String[]      @default([])
  /// A photo must be attached before the step counts as done.
  requirePhoto   Boolean       @default(false) @map("require_photo")
  /// Shown only when step #showIfPosition was answered showIfAnswer (PASS / FAIL / NA or a choice).
  showIfPosition Int?          @map("show_if_position")
  showIfAnswer   String?       @map("show_if_answer")
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  procedure Procedure @relation(fields: [procedureId], references: [id], onDelete: Cascade)

  @@unique([procedureId, position])
  @@map("procedure_steps")
}

model PmSchedule {
  id                    String            @id @default(uuid()) @db.Uuid
  organizationId        String            @map("organization_id") @db.Uuid
  restaurantId          String            @map("restaurant_id") @db.Uuid
  assetId               String?           @map("asset_id") @db.Uuid
  name                  String
  description           String?
  frequency             Frequency
  /// CUSTOM: every N days.
  intervalDays          Int?              @map("interval_days")
  /// WEEKLY: 0 = Sunday … 6 = Saturday.
  daysOfWeek            Int[]             @default([]) @map("days_of_week")
  /// MONTHLY / QUARTERLY: 1–28.
  dayOfMonth            Int?              @map("day_of_month")
  /// "HH:mm" local time the generated work order is due.
  timeOfDay             String?           @map("time_of_day")
  procedureId           String?           @map("procedure_id") @db.Uuid
  category              WorkOrderCategory @default(OTHER)
  priority              Priority          @default(MEDIUM)
  defaultAssigneeUserId String?           @map("default_assignee_user_id") @db.Uuid
  defaultAssigneeTeamId String?           @map("default_assignee_team_id") @db.Uuid
  estimatedMinutes      Int?              @map("estimated_minutes")
  /// Generate the work order this many days before it is due.
  leadTimeDays          Int               @default(0) @map("lead_time_days")
  startDate             DateTime          @map("start_date") @db.Date
  endDate               DateTime?         @map("end_date") @db.Date
  /// TIME schedules only (METER schedules keep it but ignore it).
  nextDueAt             DateTime          @map("next_due_at") @db.Timestamptz
  lastGeneratedAt       DateTime?         @map("last_generated_at") @db.Timestamptz
  /// TIME = calendar recurrence; METER = when a reading on `meterId` reaches `nextDueReading`.
  triggerType           PmTriggerType     @default(TIME) @map("trigger_type")
  /// METER: a meter on the schedule's asset.
  meterId               String?           @map("meter_id") @db.Uuid
  /// METER: a work order every this many units (every 500 h …).
  meterInterval         Decimal?          @map("meter_interval") @db.Decimal(14, 3)
  /// METER: the first (or, without an interval, the only) work order at this reading.
  meterThreshold        Decimal?          @map("meter_threshold") @db.Decimal(14, 3)
  /// METER: the reading at which the next work order is created (null = nothing more due).
  nextDueReading        Decimal?          @map("next_due_reading") @db.Decimal(14, 3)
  /// METER: the reading that created the last work order.
  lastTriggeredReading  Decimal?          @map("last_triggered_reading") @db.Decimal(14, 3)
  active                Boolean           @default(true)
  archivedAt            DateTime?         @map("archived_at") @db.Timestamptz
  createdAt             DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime          @updatedAt @map("updated_at") @db.Timestamptz

  organization        Organization @relation(fields: [organizationId], references: [id])
  restaurant          Restaurant   @relation(fields: [restaurantId], references: [id])
  asset               Asset?       @relation(fields: [assetId], references: [id])
  procedure           Procedure?   @relation(fields: [procedureId], references: [id])
  defaultAssigneeUser User?        @relation("PmDefaultAssignee", fields: [defaultAssigneeUserId], references: [id])
  defaultAssigneeTeam Team?        @relation(fields: [defaultAssigneeTeamId], references: [id])
  meter               AssetMeter?  @relation(fields: [meterId], references: [id])
  workOrders          WorkOrder[]

  @@index([organizationId, active, nextDueAt])
  @@index([restaurantId])
  @@index([assetId])
  @@index([meterId])
  @@map("pm_schedules")
}

model InspectionTemplate {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  restaurantId   String?        @map("restaurant_id") @db.Uuid
  type           InspectionType
  name           String
  procedureId    String         @map("procedure_id") @db.Uuid
  active         Boolean        @default(true)
  archivedAt     DateTime?      @map("archived_at") @db.Timestamptz
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id])
  restaurant   Restaurant?  @relation(fields: [restaurantId], references: [id])
  procedure    Procedure    @relation(fields: [procedureId], references: [id])
  inspections  Inspection[]

  @@unique([organizationId, name])
  @@index([type, restaurantId])
  @@map("inspection_templates")
}

model Inspection {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  /// INS-000123
  code           String
  templateId     String           @map("template_id") @db.Uuid
  restaurantId   String           @map("restaurant_id") @db.Uuid
  assetId        String?          @map("asset_id") @db.Uuid
  type           InspectionType
  performedById  String           @map("performed_by_id") @db.Uuid
  status         InspectionStatus @default(IN_PROGRESS)
  startedAt      DateTime         @default(now()) @map("started_at") @db.Timestamptz
  submittedAt    DateTime?        @map("submitted_at") @db.Timestamptz
  passCount      Int              @default(0) @map("pass_count")
  failCount      Int              @default(0) @map("fail_count")
  naCount        Int              @default(0) @map("na_count")
  notes          String?
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization       @relation(fields: [organizationId], references: [id])
  template     InspectionTemplate @relation(fields: [templateId], references: [id])
  restaurant   Restaurant         @relation(fields: [restaurantId], references: [id])
  asset        Asset?             @relation(fields: [assetId], references: [id])
  performedBy  User               @relation(fields: [performedById], references: [id])
  items        InspectionItem[]

  @@unique([organizationId, code])
  @@index([restaurantId, type, submittedAt])
  @@index([performedById])
  @@map("inspections")
}

model InspectionItem {
  id                    String        @id @default(uuid()) @db.Uuid
  inspectionId          String        @map("inspection_id") @db.Uuid
  position              Int
  title                 String
  instruction           String?
  inputType             StepInputType @default(PASS_FAIL_NA) @map("input_type")
  unit                  String?
  minValue              Decimal?      @map("min_value") @db.Decimal(12, 3)
  maxValue              Decimal?      @map("max_value") @db.Decimal(12, 3)
  required              Boolean       @default(true)
  options               String[]      @default([])
  requirePhoto          Boolean       @default(false) @map("require_photo")
  /// Shown only when step #showIfPosition was answered showIfAnswer (PASS / FAIL / NA or a choice).
  showIfPosition        Int?          @map("show_if_position")
  showIfAnswer          String?       @map("show_if_answer")
  result                StepResult?
  numericValue          Decimal?      @map("numeric_value") @db.Decimal(12, 3)
  textValue             String?       @map("text_value")
  note                  String?
  completedAt           DateTime?     @map("completed_at") @db.Timestamptz
  correctiveWorkOrderId String?       @map("corrective_work_order_id") @db.Uuid

  inspection          Inspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  correctiveWorkOrder WorkOrder? @relation("InspectionCorrectiveWorkOrder", fields: [correctiveWorkOrderId], references: [id])

  @@unique([inspectionId, position])
  @@map("inspection_items")
}

// =============================================================================
// Inventory
// =============================================================================

model Part {
  id                String    @id @default(uuid()) @db.Uuid
  organizationId    String    @map("organization_id") @db.Uuid
  /// Random id embedded in the part QR code (/p/<publicId>).
  publicId          String    @unique @default(dbgenerated("replace((gen_random_uuid())::text, '-'::text, ''::text)")) @map("public_id")
  name              String
  partNumber        String    @map("part_number")
  /// Optional stock-keeping code (supplier / barcode); unique when set.
  sku               String?
  /// Quantity to order when stock is low; empty = top up to twice the minimum.
  reorderQty        Decimal?  @map("reorder_qty") @db.Decimal(12, 3)
  category          String?
  unit              String    @default("pcs")
  unitCost          Decimal   @default(0) @map("unit_cost") @db.Decimal(12, 2)
  /// Default minimum; may be overridden per restaurant in `inventory`.
  minStock          Decimal   @default(0) @map("min_stock") @db.Decimal(12, 3)
  preferredVendorId String?   @map("preferred_vendor_id") @db.Uuid
  storageLocation   String?   @map("storage_location")
  description       String?
  imageKey          String?   @map("image_key")
  archivedAt        DateTime? @map("archived_at") @db.Timestamptz
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  organization    Organization @relation(fields: [organizationId], references: [id])
  preferredVendor Vendor?      @relation(fields: [preferredVendorId], references: [id])

  inventory          Inventory[]
  transactions       InventoryTransaction[]
  workOrderParts     WorkOrderPart[]
  purchaseOrderItems PurchaseOrderItem[]
  reservations       PartReservation[]
  stockCountLines    StockCountLine[]

  @@unique([organizationId, partNumber])
  @@unique([organizationId, sku])
  @@index([organizationId, category])
  @@map("parts")
}

/// Current stock of a part at a restaurant. Always equals the sum of its transactions.
model Inventory {
  id              String   @id @default(uuid()) @db.Uuid
  organizationId  String   @map("organization_id") @db.Uuid
  partId          String   @map("part_id") @db.Uuid
  restaurantId    String   @map("restaurant_id") @db.Uuid
  quantity        Decimal  @default(0) @db.Decimal(12, 3)
  minStock        Decimal? @map("min_stock") @db.Decimal(12, 3)
  storageLocation String?  @map("storage_location")
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id])
  part         Part         @relation(fields: [partId], references: [id])
  restaurant   Restaurant   @relation(fields: [restaurantId], references: [id])

  @@unique([partId, restaurantId])
  @@index([restaurantId])
  @@map("inventory")
}

/// Append-only stock ledger.
model InventoryTransaction {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  partId         String           @map("part_id") @db.Uuid
  restaurantId   String           @map("restaurant_id") @db.Uuid
  type           InventoryTxnType
  /// Positive for receipts/returns, negative for consumption.
  quantityDelta  Decimal          @map("quantity_delta") @db.Decimal(12, 3)
  balanceAfter   Decimal          @map("balance_after") @db.Decimal(12, 3)
  unitCost       Decimal?         @map("unit_cost") @db.Decimal(12, 2)
  /// e.g. WORK_ORDER / PURCHASE_ORDER / MANUAL
  referenceType  String?          @map("reference_type")
  referenceId    String?          @map("reference_id") @db.Uuid
  actorId        String?          @map("actor_id") @db.Uuid
  /// For ISSUE: the person the stock was handed to.
  issuedToId     String?          @map("issued_to_id") @db.Uuid
  reason         String?
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id])
  part         Part         @relation(fields: [partId], references: [id])
  restaurant   Restaurant   @relation(fields: [restaurantId], references: [id])
  actor        User?        @relation(fields: [actorId], references: [id])
  issuedTo     User?        @relation("StockIssuedTo", fields: [issuedToId], references: [id])

  @@index([partId, restaurantId, createdAt])
  @@index([referenceType, referenceId])
  @@index([organizationId, createdAt])
  @@map("inventory_transactions")
}

/// Stock set aside for a planned work order; available = on hand - active reservations.
model PartReservation {
  id             String            @id @default(uuid()) @db.Uuid
  organizationId String            @map("organization_id") @db.Uuid
  partId         String            @map("part_id") @db.Uuid
  restaurantId   String            @map("restaurant_id") @db.Uuid
  workOrderId    String            @map("work_order_id") @db.Uuid
  quantity       Decimal           @db.Decimal(12, 3)
  status         ReservationStatus @default(ACTIVE)
  createdById    String            @map("created_by_id") @db.Uuid
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz
  closedAt       DateTime?         @map("closed_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id])
  part         Part         @relation(fields: [partId], references: [id])
  restaurant   Restaurant   @relation(fields: [restaurantId], references: [id])
  workOrder    WorkOrder    @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  createdBy    User         @relation("ReservationCreator", fields: [createdById], references: [id])

  @@index([partId, restaurantId, status])
  @@index([workOrderId, status])
  @@map("part_reservations")
}

/// A physical stock count (cycle count) for one restaurant.
model StockCount {
  id              String           @id @default(uuid()) @db.Uuid
  organizationId  String           @map("organization_id") @db.Uuid
  /// SC-000012
  code            String
  restaurantId    String           @map("restaurant_id") @db.Uuid
  name            String
  status          StockCountStatus @default(IN_PROGRESS)
  /// Scope used when the count was created (empty = every part).
  category        String?
  storageLocation String?          @map("storage_location")
  notes           String?
  createdById     String           @map("created_by_id") @db.Uuid
  completedById   String?          @map("completed_by_id") @db.Uuid
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz
  completedAt     DateTime?        @map("completed_at") @db.Timestamptz
  cancelledAt     DateTime?        @map("cancelled_at") @db.Timestamptz
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization     @relation(fields: [organizationId], references: [id])
  restaurant   Restaurant       @relation(fields: [restaurantId], references: [id])
  createdBy    User             @relation("StockCountCreator", fields: [createdById], references: [id])
  completedBy  User?            @relation("StockCountCompleter", fields: [completedById], references: [id])
  lines        StockCountLine[]

  @@unique([organizationId, code])
  @@index([restaurantId, status])
  @@map("stock_counts")
}

model StockCountLine {
  id           String    @id @default(uuid()) @db.Uuid
  stockCountId String    @map("stock_count_id") @db.Uuid
  partId       String    @map("part_id") @db.Uuid
  /// System quantity when the line was counted (or when the count started).
  systemQty    Decimal   @map("system_qty") @db.Decimal(12, 3)
  countedQty   Decimal?  @map("counted_qty") @db.Decimal(12, 3)
  /// counted - system, fixed when the count is completed.
  variance     Decimal?  @db.Decimal(12, 3)
  unitCost     Decimal   @default(0) @map("unit_cost") @db.Decimal(12, 2)
  countedById  String?   @map("counted_by_id") @db.Uuid
  countedAt    DateTime? @map("counted_at") @db.Timestamptz

  stockCount StockCount @relation(fields: [stockCountId], references: [id], onDelete: Cascade)
  part       Part       @relation(fields: [partId], references: [id])
  countedBy  User?      @relation("StockCountLineCounter", fields: [countedById], references: [id])

  @@unique([stockCountId, partId])
  @@map("stock_count_lines")
}

// =============================================================================
// Vendors & purchasing
// =============================================================================

model Vendor {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  name           String
  contactName    String?          @map("contact_name")
  email          String?
  phone          String?
  altPhone       String?          @map("alt_phone")
  address        String?
  city           String?
  categories     VendorCategory[] @default([])
  taxId          String?          @map("tax_id")
  notes          String?
  archivedAt     DateTime?        @map("archived_at") @db.Timestamptz
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id])

  vendorRestaurants VendorRestaurant[]
  assets            Asset[]
  preferredForParts Part[]
  invoices          VendorInvoice[]
  purchaseOrders    PurchaseOrder[]
  workOrders        WorkOrder[]
  workOrderCosts    WorkOrderCost[]
  contracts         VendorContract[]

  @@unique([organizationId, name])
  @@map("vendors")
}

/// Service agreement (AMC, rate contract) with a vendor.
model VendorContract {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  vendorId       String    @map("vendor_id") @db.Uuid
  /// Empty = covers every restaurant the vendor serves.
  restaurantId   String?   @map("restaurant_id") @db.Uuid
  title          String
  contractNumber String?   @map("contract_number")
  startDate      DateTime  @map("start_date") @db.Date
  endDate        DateTime? @map("end_date") @db.Date
  value          Decimal?  @db.Decimal(12, 2)
  /// Promised response time in hours (used against actual vendor performance).
  responseHours  Int?      @map("response_hours")
  terms          String?
  archivedAt     DateTime? @map("archived_at") @db.Timestamptz
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id])
  vendor       Vendor       @relation(fields: [vendorId], references: [id])
  restaurant   Restaurant?  @relation(fields: [restaurantId], references: [id])

  @@index([vendorId])
  @@index([endDate])
  @@map("vendor_contracts")
}

model VendorRestaurant {
  vendorId     String @map("vendor_id") @db.Uuid
  restaurantId String @map("restaurant_id") @db.Uuid

  vendor     Vendor     @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@id([vendorId, restaurantId])
  @@index([restaurantId])
  @@map("vendor_restaurants")
}

model VendorInvoice {
  id              String    @id @default(uuid()) @db.Uuid
  organizationId  String    @map("organization_id") @db.Uuid
  vendorId        String    @map("vendor_id") @db.Uuid
  restaurantId    String?   @map("restaurant_id") @db.Uuid
  workOrderId     String?   @map("work_order_id") @db.Uuid
  purchaseOrderId String?   @map("purchase_order_id") @db.Uuid
  invoiceNumber   String    @map("invoice_number")
  amount          Decimal   @db.Decimal(12, 2)
  currency        String    @default("INR")
  invoiceDate     DateTime  @map("invoice_date") @db.Date
  dueDate         DateTime? @map("due_date") @db.Date
  paidAt          DateTime? @map("paid_at") @db.Timestamptz
  documentId      String?   @unique @map("document_id") @db.Uuid
  notes           String?
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  organization  Organization   @relation(fields: [organizationId], references: [id])
  vendor        Vendor         @relation(fields: [vendorId], references: [id])
  restaurant    Restaurant?    @relation(fields: [restaurantId], references: [id])
  workOrder     WorkOrder?     @relation(fields: [workOrderId], references: [id])
  purchaseOrder PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
  document      Document?      @relation(fields: [documentId], references: [id])

  @@unique([vendorId, invoiceNumber])
  @@index([vendorId, invoiceDate])
  @@index([restaurantId, invoiceDate])
  @@map("vendor_invoices")
}

model PurchaseOrder {
  id                 String              @id @default(uuid()) @db.Uuid
  organizationId     String              @map("organization_id") @db.Uuid
  /// PO-000123
  code               String
  vendorId           String              @map("vendor_id") @db.Uuid
  restaurantId       String              @map("restaurant_id") @db.Uuid
  status             PurchaseOrderStatus @default(DRAFT)
  requestedById      String              @map("requested_by_id") @db.Uuid
  approvedById       String?             @map("approved_by_id") @db.Uuid
  submittedAt        DateTime?           @map("submitted_at") @db.Timestamptz
  approvedAt         DateTime?           @map("approved_at") @db.Timestamptz
  orderedAt          DateTime?           @map("ordered_at") @db.Timestamptz
  expectedAt         DateTime?           @map("expected_at") @db.Date
  receivedAt         DateTime?           @map("received_at") @db.Timestamptz
  cancelledAt        DateTime?           @map("cancelled_at") @db.Timestamptz
  cancellationReason String?             @map("cancellation_reason")
  subtotal           Decimal             @default(0) @db.Decimal(12, 2)
  tax                Decimal             @default(0) @db.Decimal(12, 2)
  total              Decimal             @default(0) @db.Decimal(12, 2)
  currency           String              @default("INR")
  notes              String?
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime            @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id])
  vendor       Vendor       @relation(fields: [vendorId], references: [id])
  restaurant   Restaurant   @relation(fields: [restaurantId], references: [id])
  requestedBy  User         @relation("PoRequester", fields: [requestedById], references: [id])
  approvedBy   User?        @relation("PoApprover", fields: [approvedById], references: [id])

  items    PurchaseOrderItem[]
  receipts PoReceipt[]
  invoices VendorInvoice[]

  @@unique([organizationId, code])
  @@index([restaurantId, status])
  @@index([vendorId])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              String   @id @default(uuid()) @db.Uuid
  purchaseOrderId String   @map("purchase_order_id") @db.Uuid
  partId          String   @map("part_id") @db.Uuid
  description     String?
  qtyOrdered      Decimal  @map("qty_ordered") @db.Decimal(12, 3)
  qtyReceived     Decimal  @default(0) @map("qty_received") @db.Decimal(12, 3)
  unitCost        Decimal  @map("unit_cost") @db.Decimal(12, 2)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz

  purchaseOrder PurchaseOrder   @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  part          Part            @relation(fields: [partId], references: [id])
  receiptLines  PoReceiptLine[]

  @@unique([purchaseOrderId, partId])
  @@map("purchase_order_items")
}

/// One receiving event (partial or full) against a purchase order.
model PoReceipt {
  id              String   @id @default(uuid()) @db.Uuid
  purchaseOrderId String   @map("purchase_order_id") @db.Uuid
  receivedById    String   @map("received_by_id") @db.Uuid
  receivedAt      DateTime @default(now()) @map("received_at") @db.Timestamptz
  notes           String?

  purchaseOrder PurchaseOrder   @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  receivedBy    User            @relation(fields: [receivedById], references: [id])
  lines         PoReceiptLine[]

  @@index([purchaseOrderId])
  @@map("po_receipts")
}

model PoReceiptLine {
  id                  String  @id @default(uuid()) @db.Uuid
  receiptId           String  @map("receipt_id") @db.Uuid
  purchaseOrderItemId String  @map("purchase_order_item_id") @db.Uuid
  quantity            Decimal @db.Decimal(12, 3)

  receipt           PoReceipt         @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  purchaseOrderItem PurchaseOrderItem @relation(fields: [purchaseOrderItemId], references: [id])

  @@index([purchaseOrderItemId])
  @@map("po_receipt_lines")
}

// =============================================================================
// Platform: documents, notifications, audit, settings
// =============================================================================

/// Licenses, certificates, AMCs, contracts, manuals, warranty docs, invoices…
model Document {
  id             String            @id @default(uuid()) @db.Uuid
  organizationId String            @map("organization_id") @db.Uuid
  restaurantId   String?           @map("restaurant_id") @db.Uuid
  ownerType      DocumentOwnerType @map("owner_type")
  ownerId        String            @map("owner_id") @db.Uuid
  docType        DocumentType      @default(OTHER) @map("doc_type")
  title          String
  storageKey     String            @unique @map("storage_key")
  fileName       String            @map("file_name")
  mimeType       String            @map("mime_type")
  sizeBytes      Int               @map("size_bytes")
  issuedAt       DateTime?         @map("issued_at") @db.Date
  /// Drives expiry reminders for licenses, AMCs and warranties.
  expiresAt      DateTime?         @map("expires_at") @db.Date
  uploadedById   String            @map("uploaded_by_id") @db.Uuid
  archivedAt     DateTime?         @map("archived_at") @db.Timestamptz
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz

  organization  Organization   @relation(fields: [organizationId], references: [id])
  restaurant    Restaurant?    @relation(fields: [restaurantId], references: [id])
  uploadedBy    User           @relation(fields: [uploadedById], references: [id])
  vendorInvoice VendorInvoice?

  @@index([ownerType, ownerId])
  @@index([restaurantId, docType])
  @@index([expiresAt])
  @@map("documents")
}

model Notification {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  recipientId    String           @map("recipient_id") @db.Uuid
  type           NotificationType
  title          String
  body           String?
  entityType     String?          @map("entity_type")
  entityId       String?          @map("entity_id") @db.Uuid
  /// Where the notification takes the user when tapped.
  actionUrl      String?          @map("action_url")
  priority       Priority         @default(MEDIUM)
  readAt         DateTime?        @map("read_at") @db.Timestamptz
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id])
  recipient    User         @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([recipientId, readAt, createdAt])
  @@index([entityType, entityId])
  @@map("notifications")
}

model NotificationPreference {
  userId String           @map("user_id") @db.Uuid
  type   NotificationType
  inApp  Boolean          @default(true) @map("in_app")
  email  Boolean          @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, type])
  @@map("notification_preferences")
}

/// Append-only. Who did what, when, to which record, with before/after values.
model AuditLog {
  id             String          @id @default(uuid()) @db.Uuid
  organizationId String          @map("organization_id") @db.Uuid
  restaurantId   String?         @map("restaurant_id") @db.Uuid
  actorId        String?         @map("actor_id") @db.Uuid
  /// e.g. "work_order.created", "work_order.assigned", "auth.login_failed"
  action         String
  entityType     AuditEntityType @map("entity_type")
  entityId       String?         @map("entity_id") @db.Uuid
  oldValue       Json?           @map("old_value")
  newValue       Json?           @map("new_value")
  metadata       Json?
  ip             String?
  userAgent      String?         @map("user_agent")
  requestId      String?         @map("request_id")
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id])
  restaurant   Restaurant?  @relation(fields: [restaurantId], references: [id])
  actor        User?        @relation(fields: [actorId], references: [id])

  @@index([organizationId, createdAt])
  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
  @@index([action])
  @@map("audit_logs")
}

/// Key/value configuration at organization or restaurant scope.
model Setting {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  scope          SettingScope
  restaurantId   String?      @map("restaurant_id") @db.Uuid
  /// "org" for organization scope, otherwise the restaurant id — lets the unique key work with NULLs.
  scopeKey       String       @map("scope_key")
  key            String
  value          Json
  updatedById    String?      @map("updated_by_id") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id])
  restaurant   Restaurant?  @relation(fields: [restaurantId], references: [id])

  @@unique([organizationId, scopeKey, key])
  @@map("settings")
}

/// Atomic per-organization sequences for human-readable codes (WO-000123, AST-0042…).
model Counter {
  organizationId String @map("organization_id") @db.Uuid
  key            String
  value          Int    @default(0)

  organization Organization @relation(fields: [organizationId], references: [id])

  @@id([organizationId, key])
  @@map("counters")
}

// =============================================================================
// Meters, automations, root cause analysis
// =============================================================================

/// A measured value on an asset (runtime hours, temperature …).
model AssetMeter {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  assetId        String    @map("asset_id") @db.Uuid
  name           String
  type           MeterType
  unit           String
  currentValue   Decimal?  @map("current_value") @db.Decimal(14, 3)
  previousValue  Decimal?  @map("previous_value") @db.Decimal(14, 3)
  lastReadingAt  DateTime? @map("last_reading_at") @db.Timestamptz
  archivedAt     DateTime? @map("archived_at") @db.Timestamptz
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization   @relation(fields: [organizationId], references: [id])
  asset        Asset          @relation(fields: [assetId], references: [id])
  readings     MeterReading[]
  pmSchedules  PmSchedule[]

  @@index([assetId])
  @@map("asset_meters")
}

model MeterReading {
  id            String   @id @default(uuid()) @db.Uuid
  meterId       String   @map("meter_id") @db.Uuid
  value         Decimal  @db.Decimal(14, 3)
  previousValue Decimal? @map("previous_value") @db.Decimal(14, 3)
  readAt        DateTime @default(now()) @map("read_at") @db.Timestamptz
  userId        String   @map("user_id") @db.Uuid
  workOrderId   String?  @map("work_order_id") @db.Uuid
  note          String?

  meter     AssetMeter @relation(fields: [meterId], references: [id], onDelete: Cascade)
  user      User       @relation("MeterReader", fields: [userId], references: [id])
  workOrder WorkOrder? @relation(fields: [workOrderId], references: [id], onDelete: SetNull)

  @@index([meterId, readAt])
  @@map("meter_readings")
}

/// IF <trigger> AND <conditions> THEN <actions>, configured by admins.
model Automation {
  id             String            @id @default(uuid()) @db.Uuid
  organizationId String            @map("organization_id") @db.Uuid
  /// Empty = every restaurant.
  restaurantId   String?           @map("restaurant_id") @db.Uuid
  name           String
  description    String?
  trigger        AutomationTrigger
  conditions     Json              @default("{}")
  actions        Json              @default("[]")
  active         Boolean           @default(true)
  runCount       Int               @default(0) @map("run_count")
  lastRunAt      DateTime?         @map("last_run_at") @db.Timestamptz
  createdById    String            @map("created_by_id") @db.Uuid
  archivedAt     DateTime?         @map("archived_at") @db.Timestamptz
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization    @relation(fields: [organizationId], references: [id])
  restaurant   Restaurant?     @relation(fields: [restaurantId], references: [id])
  createdBy    User            @relation("AutomationCreator", fields: [createdById], references: [id])
  logs         AutomationLog[]

  @@index([organizationId, trigger, active])
  @@map("automations")
}

model AutomationLog {
  id           String              @id @default(uuid()) @db.Uuid
  automationId String              @map("automation_id") @db.Uuid
  trigger      AutomationTrigger
  status       AutomationRunStatus
  entityType   String?             @map("entity_type")
  entityId     String?             @map("entity_id") @db.Uuid
  message      String?
  createdAt    DateTime            @default(now()) @map("created_at") @db.Timestamptz

  automation Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)

  @@index([automationId, createdAt])
  @@map("automation_logs")
}

/// Why a failure happened and what stops it happening again.
model RootCauseAnalysis {
  id               String          @id @default(uuid()) @db.Uuid
  organizationId   String          @map("organization_id") @db.Uuid
  workOrderId      String          @unique @map("work_order_id") @db.Uuid
  assetId          String?         @map("asset_id") @db.Uuid
  failure          String
  cause            String?
  rootCause        String          @map("root_cause")
  category         FailureCategory
  correctiveAction String?         @map("corrective_action")
  preventiveAction String?         @map("preventive_action")
  createdById      String          @map("created_by_id") @db.Uuid
  updatedById      String?         @map("updated_by_id") @db.Uuid
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime        @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id])
  workOrder    WorkOrder    @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  asset        Asset?       @relation(fields: [assetId], references: [id])
  createdBy    User         @relation("RcaCreator", fields: [createdById], references: [id])
  updatedBy    User?        @relation("RcaUpdater", fields: [updatedById], references: [id])

  @@index([assetId])
  @@index([organizationId, category])
  @@map("root_cause_analyses")
}

// =============================================================================
// Delivery channels and offline sync
// =============================================================================

/// A browser's Web Push endpoint for one user.
model PushSubscription {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

/// Replays of a write sent again by the offline queue return the first result.
model IdempotencyKey {
  userId     String   @map("user_id") @db.Uuid
  key        String
  method     String
  path       String
  statusCode Int      @map("status_code")
  body       Json?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@id([userId, key])
  @@index([createdAt])
  @@map("idempotency_keys")
}

// =============================================================================
// Repeat & saved views
// =============================================================================

enum RepeatUnit {
  DAY
  WEEK
  MONTH
}

enum RepeatBasis {
  /// Next due date = this due date + interval (missed ones are skipped).
  SCHEDULE
  /// Next due date = when this one was completed + interval.
  COMPLETION
}

/// A named set of list filters (the list page's query string). Private, or shared with everyone.
model SavedView {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  /// Which list: work_orders, requests, assets, parts.
  resource       String
  name           String
  /// The list's URL query string, e.g. "status=OPEN&priority=HIGH".
  query          String
  shared         Boolean  @default(false)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId, resource])
  @@index([userId, resource])
  @@map("saved_views")
}

// =============================================================================
// Custom fields & labels
// =============================================================================

enum CustomFieldEntity {
  WORK_ORDER
  ASSET
}

enum CustomFieldType {
  TEXT
  NUMBER
  DATE
  SELECT
  CHECKBOX
}

/// An extra field the organisation adds to work orders or assets (values live on the record).
model CustomField {
  id             String            @id @default(uuid()) @db.Uuid
  organizationId String            @map("organization_id") @db.Uuid
  entity         CustomFieldEntity
  label          String
  type           CustomFieldType   @default(TEXT)
  /// SELECT choices.
  options        String[]          @default([])
  required       Boolean           @default(false)
  position       Int               @default(0)
  archivedAt     DateTime?         @map("archived_at") @db.Timestamptz
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, entity])
  @@map("custom_fields")
}

/// A coloured label (custom category) put on work orders, e.g. "Health inspection", "Guest complaint".
model Label {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  name           String
  /// Palette key (blue, green, amber, red, violet, slate…).
  color          String    @default("blue")
  archivedAt     DateTime? @map("archived_at") @db.Timestamptz
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz

  organization Organization     @relation(fields: [organizationId], references: [id])
  workOrders   WorkOrderLabel[]

  @@unique([organizationId, name])
  @@map("labels")
}

model WorkOrderLabel {
  workOrderId String @map("work_order_id") @db.Uuid
  labelId     String @map("label_id") @db.Uuid

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  label     Label     @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([workOrderId, labelId])
  @@index([labelId])
  @@map("work_order_labels")
}

// =============================================================================
// Team chat
// =============================================================================

enum ConversationType {
  DIRECT
  GROUP
}

/// A chat between two people (DIRECT) or a named group.
model Conversation {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  type           ConversationType
  /// Groups only.
  name           String?
  /// DIRECT: "<smaller user id>:<larger user id>" so a pair has one chat.
  directKey      String?          @unique @map("direct_key")
  createdById    String           @map("created_by_id") @db.Uuid
  lastMessageAt  DateTime         @default(now()) @map("last_message_at") @db.Timestamptz
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz

  organization Organization         @relation(fields: [organizationId], references: [id])
  createdBy    User                 @relation(fields: [createdById], references: [id])
  members      ConversationMember[]
  messages     ChatMessage[]

  @@index([organizationId, lastMessageAt])
  @@map("conversations")
}

model ConversationMember {
  conversationId String    @map("conversation_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  joinedAt       DateTime  @default(now()) @map("joined_at") @db.Timestamptz
  lastReadAt     DateTime  @default(now()) @map("last_read_at") @db.Timestamptz
  /// Left the group: keeps history out of their list.
  leftAt         DateTime? @map("left_at") @db.Timestamptz

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId])
  @@map("conversation_members")
}

model ChatMessage {
  id             String    @id @default(uuid()) @db.Uuid
  conversationId String    @map("conversation_id") @db.Uuid
  authorId       String    @map("author_id") @db.Uuid
  body           String
  /// Optional link to a work order mentioned in the chat.
  workOrderId    String?   @map("work_order_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  author       User         @relation(fields: [authorId], references: [id])

  @@index([conversationId, createdAt])
  @@map("chat_messages")
}

// =============================================================================
// Public API & webhooks
// =============================================================================

/// A key for the REST API. Only a hash is stored; the key acts as its creator, limited to its scopes.
model ApiKey {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  name           String
  /// First characters shown in the list, e.g. "mx_live_ab12".
  prefix         String
  hash           String    @unique
  /// Permission keys the key may use (subset of its creator's).
  scopes         String[]
  createdById    String    @map("created_by_id") @db.Uuid
  lastUsedAt     DateTime? @map("last_used_at") @db.Timestamptz
  expiresAt      DateTime? @map("expires_at") @db.Timestamptz
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id])
  createdBy    User         @relation(fields: [createdById], references: [id])

  @@index([organizationId])
  @@map("api_keys")
}

/// An HTTPS endpoint told about events (work order created / completed, request created…).
model Webhook {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  url            String
  events         String[]
  /// HMAC-SHA256 signing secret (shown once when created).
  secret         String
  active         Boolean   @default(true)
  lastStatus     Int?      @map("last_status")
  lastError      String?   @map("last_error")
  lastSentAt     DateTime? @map("last_sent_at") @db.Timestamptz
  failureCount   Int       @default(0) @map("failure_count")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz

  organization Organization      @relation(fields: [organizationId], references: [id])
  deliveries   WebhookDelivery[]

  @@index([organizationId])
  @@map("webhooks")
}

model WebhookDelivery {
  id         String   @id @default(uuid()) @db.Uuid
  webhookId  String   @map("webhook_id") @db.Uuid
  event      String
  status     Int?
  error      String?
  durationMs Int      @default(0) @map("duration_ms")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  webhook Webhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([webhookId, createdAt])
  @@map("webhook_deliveries")
}

// =============================================================================
// Scheduled email reports
// =============================================================================

/// A report emailed on a schedule (daily / weekly / monthly, org time zone).
/// It runs with its creator's access, so recipients never see more than they could.
model ReportSchedule {
  id               String          @id @default(uuid()) @db.Uuid
  organizationId   String          @map("organization_id") @db.Uuid
  /// Empty = every restaurant the creator can see.
  restaurantId     String?         @map("restaurant_id") @db.Uuid
  /// One of REPORT_KEYS.
  reportKey        String          @map("report_key")
  /// Work-order filters (priority, status, type, userId, teamId, vendorId, assetId, locationId).
  filters          Json            @default("{}")
  frequency        ReportFrequency
  /// "HH:mm" in the organization's time zone.
  timeOfDay        String          @map("time_of_day")
  /// WEEKLY: 0 = Sunday … 6 = Saturday.
  dayOfWeek        Int?            @map("day_of_week")
  /// MONTHLY: 1–28.
  dayOfMonth       Int?            @map("day_of_month")
  format           ReportFormat    @default(PDF)
  recipientUserIds String[]        @default([]) @map("recipient_user_ids") @db.Uuid
  recipientEmails  String[]        @default([]) @map("recipient_emails")
  createdById      String          @map("created_by_id") @db.Uuid
  active           Boolean         @default(true)
  nextRunAt        DateTime        @map("next_run_at") @db.Timestamptz
  lastRunAt        DateTime?       @map("last_run_at") @db.Timestamptz
  archivedAt       DateTime?       @map("archived_at") @db.Timestamptz
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime        @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization        @relation(fields: [organizationId], references: [id])
  restaurant   Restaurant?         @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  createdBy    User                @relation(fields: [createdById], references: [id])
  runs         ReportScheduleRun[]

  @@index([active, nextRunAt])
  @@index([organizationId])
  @@map("report_schedules")
}

/// One attempt to send a scheduled report ("sent", "skipped: email not configured", "failed: …").
model ReportScheduleRun {
  id           String   @id @default(uuid()) @db.Uuid
  scheduleId   String   @map("schedule_id") @db.Uuid
  /// The due instant this run was for: unique, so a run is never sent twice.
  scheduledFor DateTime @map("scheduled_for") @db.Timestamptz
  status       String
  recipients   Int      @default(0)
  rows         Int?
  error        String?
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  schedule ReportSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@unique([scheduleId, scheduledFor])
  @@map("report_schedule_runs")
}

/// When each background job last started. The cron endpoint (called every
/// 15 minutes) uses it to run each job only at its own pace and never twice at once.
model JobRun {
  name          String    @id
  lastStartedAt DateTime  @map("last_started_at") @db.Timestamptz
  lastEndedAt   DateTime? @map("last_ended_at") @db.Timestamptz
  lastResult    Json?     @map("last_result")

  @@map("job_runs")
}

/// Shared rate-limit counters (see middleware/rate-limit-store.ts).
model RateLimitHit {
  key     String   @id
  hits    Int
  resetAt DateTime @map("reset_at") @db.Timestamptz

  @@index([resetAt])
  @@map("rate_limit_hits")
}
