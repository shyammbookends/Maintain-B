    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.0.10",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.7.0",
    "axe-core": "^4.13.0",
