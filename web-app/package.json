{
  "name": "maintainx",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Restaurant Maintenance & Operations Management platform",
  "engines": {
    "node": ">=20.19"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "postinstall": "npm run build -w @maintainx/shared && npm run db:generate",
    "dev": "concurrently -k -n shared,api,web -c gray,blue,green \"npm run dev -w @maintainx/shared\" \"npm run dev -w @maintainx/server\" \"npm run dev -w @maintainx/web\"",
    "dev:clean": "node scripts/free-ports.mjs && npm run dev",
    "stop": "node scripts/free-ports.mjs",
    "build": "npm run build -w @maintainx/shared && npm run build -w @maintainx/server && npm run build -w @maintainx/web",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "db:generate": "npm run db:generate -w @maintainx/server",
    "db:migrate": "npm run db:migrate -w @maintainx/server",
    "db:deploy": "npm run db:deploy -w @maintainx/server",
    "db:seed": "npm run db:seed -w @maintainx/server",
    "db:studio": "npm run db:studio -w @maintainx/server",
    "supabase:setup": "node scripts/supabase-setup.mjs",
    "push:keys": "npm run push:keys -w @maintainx/server --",
    "vercel-build": "node scripts/vercel-build.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "concurrently": "^9.2.0",
    "eslint": "^9.30.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.35.0"
  }
}
